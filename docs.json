{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "DJ Support",
  "description": "Move curated Rekordbox and Beatport selections into reviewable Spotify playlists.",
  "colors": {
    "primary": "#6948E8",
    "light": "#A996FF",
    "dark": "#684AEF"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "DM Sans",
    "heading": {
      "family": "Space Grotesk",
      "weight": 650
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F7F6FB",
      "dark": "#0B0A10"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "pages": [
      {
        "group": "Start",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Understand",
        "pages": ["concepts/transfers", "concepts/safety"]
      },
      {
        "group": "Operate",
        "pages": ["guides/preview", "guides/review-and-approve"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/spontain112/djsupport",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Releases",
        "href": "https://github.com/spontain112/djsupport/releases/latest"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/spontain112/djsupport"
    }
  }
}

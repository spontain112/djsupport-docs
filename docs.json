{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "DJ Support",
  "description": "Move selected Rekordbox playlists into Spotify with review and explicit approval.",
  "colors": {
    "primary": "#177A50",
    "light": "#61D39A",
    "dark": "#239466"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "DM Sans",
    "heading": {
      "family": "Space Grotesk",
      "weight": 650
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F5F7F5",
      "dark": "#0B0D0C"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/spontain112/djsupport",
          "icon": "github"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Use DJ Support",
        "icon": "headphones",
        "groups": [
          {
            "group": "Start",
            "pages": ["index", "use/first-preview"]
          },
          {
            "group": "Review and publish",
            "pages": ["use/review-and-approve"]
          },
          {
            "group": "Choose a workflow",
            "pages": ["use/transfers", "use/beatport"]
          },
          {
            "group": "Keep it safe",
            "pages": ["use/backup-and-restore", "use/upgrade", "use/troubleshooting", "use/support"]
          }
        ]
      },
      {
        "tab": "Build DJ Support",
        "icon": "code-2",
        "groups": [
          {
            "group": "Contribute",
            "pages": ["build/overview", "build/contributing"]
          },
          {
            "group": "Understand the system",
            "pages": ["build/architecture", "build/domain-model", "build/lifecycles", "build/storage"]
          },
          {
            "group": "Reference",
            "pages": ["build/agent-contract", "build/releases", "build/decisions"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Latest release",
        "href": "https://github.com/spontain112/djsupport/releases/latest"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sync your first playlist",
      "href": "/use/first-preview"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/spontain112/djsupport"
    }
  }
}
